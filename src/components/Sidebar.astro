---
import {getPostsMetadata} from "../content.loader";
import {SITE_ICON} from "../consts";
const posts = await getPostsMetadata();

const postsByCategory: Record<string, Array<{title: string, url: string}>> = {};
posts.forEach(post => {
    const parts = post.slug.split('/');
    const category = parts.length > 1 ? parts[0] : 'Other';
    if (!postsByCategory[category]) {
        postsByCategory[category] = [];
    }
    postsByCategory[category].push({
        title: post.title,
        url: post.url,
    });
});

---


<div class="sidebar-content">
    <h3>
        <a href="/site/" style="color: var(--text-yellow)">
            Will-Pettifer
            <svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
                 style="filter: drop-shadow(0 0 2px var(--accent-color))">
                <path
                        fill="currentColor"
                        d={SITE_ICON}>
                </path>
                <title>Site</title>
            </svg>
        </a>
    </h3>
    <br/>
    <ul class="sidebar-ul">
        {Object.entries(postsByCategory).map(([category, items]) => (
                <li>
                    <span class="caret">{category}</span>
                    <ul class="nested">
                        {items.map(item => (
                                <li><a href={item.url}>{item.title}</a></li>
                        ))}
                    </ul>
                </li>
        ))}
    </ul>
</div>


<style>
    a {
        color: var(--text-color);
        text-decoration: none;
        user-select: none;
    }
    a:hover {
        color: var(--link-color);
    }

    .sidebar-content {
        direction: rtl;
        padding: 1em;
        text-align: right;
        word-spacing: normal;
    }

    .sidebar-ul{
        font-family: var(--font-code), monospace;
        direction: ltr;
        list-style-type: none;
        margin: 0;
        padding: 0;
    }

    .caret{
        cursor: pointer;
        user-select: none;
        color: var(--text-green);
        font-weight: bold;
        text-shadow: 0 0 2px var(--accent-color);
    }
    .caret:hover{
        color: var(--link-color);
    }

    .caret::after {
        content: "+";
        font-size: 0.8em;
        position: relative;
        left: 0.5em;
        padding: 0;
        margin: 0;
    }

    .caret-down::after {
        content: "-";
    }
    .nested {
        display: none;
        list-style: none;
        font-weight: 400;
        font-size: 0.9em;
        font-family: var(--font-code), monospace;
        font-style: italic;
        padding: 0;
        margin: 0;
    }

    .nested li {
        position: relative;
        padding: 0;
        margin: 0;
    }

    .nested li::after {
        content: "";
        position: absolute;
        top: 0.7em;
        right: -1.1em;
        width: 4px;
        height: 4px;
        background: var(--text-green);
    }
    .active {
        display: block;
    }
</style>