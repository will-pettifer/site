---
import {CV_ICON, CV_URL, GITHUB_ICON, GITHUB_URL, ITCH_ICON, ITCH_URL, LINKEDIN_ICON, LINKEDIN_URL} from "../consts";
const today = new Date()
---


<footer>
    &copy; {today.getFullYear()} William Pettifer. All rights reserved.
    <br> <a href="mailto:william.j.g.pettifer@gmail.com">william.j.g.pettifer@gmail.com</a>
    <div class="social-links">
        <a href={CV_URL} target="_blank">CV</a>
        :: <a href={LINKEDIN_URL} target="_blank">LinkedIn</a>
        :: <a href={ITCH_URL} target="_blank">itch.io</a>
        :: <a href={GITHUB_URL} target="_blank">GitHub</a>
    </div>
</footer>


<style>
    footer {
        color: var(--subtext-color);
        font-family: var(--font-code), monospace;
        font-size: 0.9em;
        padding: 0 1em 4em 1em;
        justify-content: center;
        text-align: center;
        word-spacing: normal;
    }

    a{
        text-decoration: none;
        color: var(--text-sky);
    }
    a:hover{
        color: var(--link-color);
    }

    .social-links{
    }
</style>