---
import {SITE_TITLE, SITE_DESCRIPTION} from "../consts";
import BaseHead from "../components/BaseHead.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <button class="menu-toggle" aria-label="Toggle Sidebar"><<</button>

        <div class="container">
            <div class="layout">

                <nav class="sidenav">
                    <div class="sidenav-scroll">
                        <Sidebar />
                    </div>
                </nav>

                <div class="divider">

                    <span class="divider-decor" style="top: -25px;">░</span>

                    <div class="divider-box"></div>

                    <span class="divider-decor" style="top: calc(100vh * 0.25);">░</span>

                </div>

                <div class="main-frame">
                    <div class="main-scroll">
                        <main>
                            <slot />
                        </main>

                        <Footer />
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>

<style>
    .container {
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
        background: var(--background-color);
    }

    .layout {
        display: flex;
        justify-content: center;
        height: 100vh;
    }

    .menu-toggle {
        display: none;
        position: fixed;
        top: 20px;
        left: 20px;
        z-index: 200;
        background: var(--background-color);
        padding: 12px 16px;
        cursor: pointer;
    }

    .menu-toggle:hover {
        background: var(--background-color-2);
    }

    .sidenav {
        flex: 0 0 300px;
        position: sticky;
        direction: rtl;
        height: 100vh;
        overflow: hidden;
        background: var(--background-color);
    }

    .sidenav-scroll {
        padding-top: 90px;
        height: calc(100vh - 90px);
        overflow-y: auto;
        min-height: 0;
    }
    .sidenav::before {
        padding-top: 60px;
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        right: 0;
        width: 1px;
        background: repeating-linear-gradient(
                to bottom,
                var(--accent-color),
                var(--accent-color) 0.2rem,
                transparent 0.2rem,
                transparent 0.4rem
        );
    }

    .main-frame {
        top: 0;
        position: relative;
        flex: 0 1 800px;
        height: 100vh;
        overflow: hidden;
    }

    .main-scroll {
        padding-top: 0;
        height: 100%;
        overflow-y: auto;
        min-height: 0;
    }

    .divider {
        z-index: 200;
        margin: 40px 0 0 0;
        top: 40px;
        flex: 0 0 20px;
        width: 20px;
        position: sticky;
        align-self: flex-start;
    }
    .divider::before {
        content: "";
        position: absolute;
        height: calc(100vh * 0.7);
        right: 0;
        width: 1px;
        background: repeating-linear-gradient(
                to bottom,
                var(--accent-color),
                var(--accent-color) 0.2rem,
                transparent 0.2rem,
                transparent 0.4rem
        );
    }

    .divider-box {
        position: relative;
        height: calc(100vh * 0.4);
        border-top: 1px dashed var(--accent-color);
        border-bottom: 1px dashed var(--accent-color);
        top: 35px;
    }

    .divider-decor {
        user-select: none;
        left: 0.8em;
        font-size: 0.7em;
        position: relative;
    }

    /* Tablet/Small Desktop: Nav overlays content */
    @media (max-width: 1080px) {
        .menu-toggle {
            display: block;
        }

        .container {
            max-width: 100%;
        }

        .layout {
            justify-content: center;
            gap: 0;
        }

        .sidenav {
            position: fixed;
            top: 40px;
            left: 0;
            transform: translateX(-100%);
        }

        .sidenav:not(.collapsed) {
            transform: translateX(0);
        }

        main {
            margin: 0 auto;
        }
    }
</style>

<script>
    import { sidebarState } from '../SidebarState.ts';

    document.addEventListener('DOMContentLoaded', () => {
        sidebarState.init();
    });
</script>