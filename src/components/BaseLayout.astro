---
import {SITE_TITLE, SITE_DESCRIPTION} from "../consts";
import BaseHead from "../components/BaseHead.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
    <head title = {SITE_TITLE}>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <button class="menu-toggle" aria-label="Toggle Sidebar">☰</button>


        <nav class="sidenav">
            <Sidebar />
            <div class="divider">

                <span class="divider-decor" style="top: 9%;">✿</span>

                <div class="divider-box"></div>

                <span class="divider-decor" style="top: 79%;">✿</span>

            </div>
        </nav>

        <div class="main-frame">
            <main>
                <slot />
                <Footer />
            </main>
        </div>

    </body>
</html>

<style>
    .menu-toggle {
        display: none;
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 200;
        font-size: 2.2em;
        color: var(--text-color);
        font-family: var(--font-code), monospace;
        border: 1px solid var(--accent-color);
        border-radius: 0.1em;
        background: var(--background-color);
        padding: 0 0.3em;
        cursor: pointer;
    }

    .menu-toggle:hover {
        background: var(--background-color-2);
        color: var(--link-color);
    }

    .sidenav {
        position: fixed;
        left: calc((100vw - 1130px) / 2);
        top: 0;
        width: 280px;
        height: 100vh;
        overflow-y: auto;
        z-index: 100;
        direction: rtl;
        background: var(--background-color);
    }

    .main-frame {
        margin-left: calc(((100vw - 1130px) / 2) + 320px);
    }

    main {
        max-width: 800px;
    }

    .divider {
        position: fixed;
        left: calc(((100vw - 1130px) / 2) + 280px);
        top: 0;
        width: 20px;
        height: 100vh;
        z-index: 200;
    }

    .divider::before {
        content: "";
        position: absolute;
        top: 10%;
        height: calc(100vh * 0.7);
        right: 0;
        width: 1px;
        background: repeating-linear-gradient(
                to bottom,
                var(--accent-color),
                var(--accent-color) 0.2rem,
                transparent 0.2rem,
                transparent 0.4rem
        );
    }

    .divider::after {
        content: "";
        position: absolute;
        top: 0;
        height: 100vh;
        left: 0;
        width: 1px;
        background: repeating-linear-gradient(
                to bottom,
                var(--accent-color),
                var(--accent-color) 0.2rem,
                transparent 0.2rem,
                transparent 0.4rem
        );
    }

    .divider-box {
        position: relative;
        height: calc(100vh * 0.4);
        border-top: 1px dashed var(--accent-color);
        border-bottom: 1px dashed var(--accent-color);
        top: 20%;
    }

    .divider-decor {
        position: absolute;
        user-select: none;
        left: 0.5em;
    }

    /* Tablet/Small Desktop: Nav overlays content */
    @media (max-width: 1130px) {
        .menu-toggle {
            display: block;
        }

        .divider {
            display: none;
        }

        .sidenav {
            position: fixed;
            left: auto;
            right: 20px;
            top: 40px;
            height: calc(100vh - 200px);
            width: 280px;
            border: 1px solid var(--accent-color);
            border-radius: 0.2em;
            transform: translateX(200%);
        }

        .sidenav:not(.collapsed) {
            transform: translateX(0);
        }

        .main-frame {
            margin-left: 0;
        }

        main {
            margin: 0 auto;
        }
    }
</style>

<script>
    import { sidebarState } from '../SidebarState.ts';

    document.addEventListener('DOMContentLoaded', () => {
        sidebarState.init();
    });
</script>