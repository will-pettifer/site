---
import type {ImageMetadata} from "astro";
import Image from "astro/components/Image.astro";
interface Props {
    image: ImageMetadata;
    link: string;
    title: string;
    description: string;
    alt?: string;
}

const { image, link, title, description, alt = "Card image" } = Astro.props;
---


<a href={link} class="card">
    <Image src={image} alt={alt} class="card-image" />
    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>
</a>

<style>
    .card {
        display: block;
        border: 1px solid var(--accent-color);
        border-radius: 0.2em;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        width: 100%;
    }

    .card:hover {
        border: 1px solid var(--code-color);
        background-color: var(--background-color-2);
    }

    .card-image {
        border: none;
        border-radius: 0;
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
    }

    .card-title {
        padding: 0.5rem 1rem;
        margin: 0;
        font-size: 1.2em;
        color: var(--text-pink);
    }

    .card-description {
        padding: 0 1rem 1rem;
        margin: 0;
        font-size: 0.8em;
        line-height: 1.5;
    }
</style>