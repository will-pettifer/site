---
import BaseLayout from "../components/BaseLayout.astro";
import { Image } from 'astro:assets';
import image from "../images/Baccki-export.png";
import ArticlePreview from "../components/ArticlePreview.astro";
---

<BaseLayout>
    <main class="main">
        <div class="article-title">
            <h1 class="article-name" style="margin-bottom: 0.1em">Welcome! 🌿︎</h1>
            <hr>
        </div>
        <article>
            <p>
                Hi, I'm Will, I'm a UK-based Game-Developer, and this is my website. If you check the Dev Blog tab
                 in the menu, you can see some of the projects I've worked on. CV and social, and contact links are at the bottom of the page.
            </p>
            <Image src={image} alt="Background from a game I made." loading="eager" /> <br>
            <hr>
        </article>
    </main>
</BaseLayout>
